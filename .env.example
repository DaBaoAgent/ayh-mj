# 复制成 .env 并填入真实值；本文件只列变量名，不含任何密钥（可以提交进仓库）。
# 环境变量优先级高于 config/default.yaml。

# ── 路径 / 工具（留空 = 自动探测）────────────────────────────
# AYHMJ_ROOT=D:\path\to\ayh-mj
# AYHMJ_CONFIG=config/default.yaml
# AYHMJ_FFMPEG=
# AYHMJ_FFPROBE=
# AYHMJ_FONTS_DIR=
# AYHMJ_PYTHON=
# AYHMJ_POSTFLOW_DIR=
# AYHMJ_DESKTOP_DIR=
# AYHMJ_KEYFILE=

# ── 密钥（优先环境变量；也可放进系统凭据库 keyring）──────────
# AUTODL_API_KEY=
# DEEPSEEK_API_KEY=
# VOLCANO_API_KEY=
# UPLOADPOST_API_KEY=

# ── 行为开关 ────────────────────────────────────────────────
# AYHMJ_RUN_LIVE=1     # 放行 live 测试
# AYHMJ_RUN_PAID=1     # 放行 paid 测试（会真花钱）
# AYHMJ_WEBUI_PORT=8899
